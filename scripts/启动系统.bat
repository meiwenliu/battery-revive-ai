@echo off
chcp 65001 >nul
title 焕芯·电愈智策 系统启动器
echo ======================================================================
echo   正在启动《焕芯·电愈智策》多体系电池智能快速诊断与低碳循环决策系统
echo ======================================================================
echo.
echo [1/2] 正在启动后端 FastAPI 接口服务...
cd /d "%~dp0backend"

start /b python -m uvicorn app.main:app --host 127.0.0.1 --port 8000

echo [2/2] 等待服务初始化并在浏览器中打开页面...
timeout /t 2 /nobreak >nul
start "" "http://127.0.0.1:8000"

echo.
echo 系统服务已在后台运行中 (http://127.0.0.1:8000)
echo 如需关闭服务，可直接关闭此命令行窗口。
echo ======================================================================
pause
